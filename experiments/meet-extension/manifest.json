{
  "manifest_version": 3,
  "name": "Cuelo feasibility check \u2014 no AI",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Cuelo feasibility",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meeting-state.js",
        "panel.js"
      ]
    }
  ]
}
